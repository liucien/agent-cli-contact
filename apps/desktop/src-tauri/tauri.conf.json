{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Workbench",
  "version": "0.1.0",
  "identifier": "dev.workbench.agent-workbench",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter @workbench/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/gateway"]
  }
}
